# Test environment — dedicated database for e2e tests.
# Loaded by test/setup-env.ts before the Nest app boots.

# Application
PORT=3001

# Database (separate test database)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=nguyen.hong.sonb
DB_PASSWORD=
DB_DATABASE=medium_clone_test
DB_LOGGING=false
# Auto-create the schema from entities for tests (never enable in prod).
DB_SYNCHRONIZE=true

# JWT
JWT_SECRET=test-jwt-secret
JWT_EXPIRES_IN=1d

# JWT refresh token
JWT_REFRESH_SECRET=test-jwt-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# Cron cleanup schedules (kept, harmless during tests)
TOKEN_BLACKLIST_CLEANUP_CRON=0 0 * * *
REFRESH_TOKEN_CLEANUP_CRON=0 0 * * *
