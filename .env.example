# Application
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=medium_clone
DB_LOGGING=false

# JWT
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

# Token blacklist cleanup schedule (cron expression, default: daily at midnight)
TOKEN_BLACKLIST_CLEANUP_CRON=0 0 * * *

# JWT refresh token
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_EXPIRES_IN=7d

# Refresh token cleanup schedule (cron expression, default: daily at midnight)
REFRESH_TOKEN_CLEANUP_CRON=0 0 * * *
